# Copy to .env and fill values for the providers you want to enable.
# Leaving required keys empty will mark the provider as not-configured;
# health endpoints and provider/contract tests will skip with a clear reason.
# Endpoints default to hosted APIs—override for private gateways or local dev.

# AgentOS access (required): set the API key expected by CLI/SDK/HTTP requests.
AGNO_API_KEY=dev-local-key

# OpenAI (required: OPENAI_API_KEY)
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1          # optional; override for proxy/Azure
OPENAI_ORG=                                        # optional; org scoping
OPENAI_API_VERSION=                                # optional; required for Azure/preview versions
OPENAI_CHAT_MODEL=gpt-4o-mini                      # required for chat/stream
OPENAI_EMBED_MODEL=text-embedding-3-small          # required for embeddings

# Gemini / Vertex (provide GEMINI_API_KEY or Vertex settings; empty disables)
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-1.5-pro
GEMINI_EMBED_MODEL=textembedding-gecko
VERTEX_PROJECT=                                    # optional; set when using Vertex
VERTEX_LOCATION=                                   # optional; e.g. us-central1
VERTEX_CHAT_MODEL=                                 # optional; override when using Vertex
VERTEX_EMBED_MODEL=                                # optional; override when using Vertex

# GLM4 (required: GLM4_API_KEY)
GLM4_API_KEY=
GLM4_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
GLM4_CHAT_MODEL=glm-4
GLM4_EMBED_MODEL=glm-4-embedding

# OpenRouter (required: OPENROUTER_API_KEY)
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openrouter/auto
OPENROUTER_EMBED_MODEL=openrouter/embedding

# SiliconFlow (required: SILICONFLOW_API_KEY)
SILICONFLOW_API_KEY=
SILICONFLOW_ENDPOINT=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=qwen2.5-72b-instruct
SILICONFLOW_EMBED_MODEL=bge-large-en-v1.5

# Cerebras (required: CEREBRAS_API_KEY)
CEREBRAS_API_KEY=
CEREBRAS_ENDPOINT=https://api.cerebras.ai/v1
CEREBRAS_CHAT_MODEL=llama3.1-8b
CEREBRAS_EMBED_MODEL=mistral-embed

# ModelScope (required: MODELSCOPE_API_KEY)
MODELSCOPE_API_KEY=
MODELSCOPE_ENDPOINT=https://api.modelscope.cn/v1
MODELSCOPE_CHAT_MODEL=qwen2-7b-instruct
MODELSCOPE_EMBED_MODEL=bge-base-en-v1.5

# Groq (required: GROQ_API_KEY)
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama3-8b-8192
GROQ_EMBED_MODEL=text-embedding-3-large

# Ollama / vLLM local (optional; leave empty to disable)
# Endpoint must point to the Ollama API root (default /api)
OLLAMA_ENDPOINT=http://localhost:11434/api
OLLAMA_CHAT_MODEL=huihui_ai/qwen3-abliterated:8b
OLLAMA_EMBED_MODEL=huihui_ai/deepseek-r1-abliterated:8b
